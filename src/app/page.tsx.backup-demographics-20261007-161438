'use client';

import Image from 'next/image';
import { ChangeEvent, useCallback, useEffect, useRef, useState } from 'react';
import { FiArrowLeft, FiCamera, FiImage, FiMapPin, FiUser, FiX } from 'react-icons/fi';

type Demographics = Record<string, Record<string, number>>;

type Category = 'race' | 'age' | 'gender';

const CATEGORY_ORDER: Category[] = ['race', 'age', 'gender'];

function validateText(value: string) {
  const trimmed = value.trim();
  return trimmed.length > 0 && !/\d/.test(trimmed);
}

function sortScores(values: Record<string, number>) {
  return Object.entries(values).sort((a, b) => b[1] - a[1]);
}

function formatLabel(value: string) {
  return value
    .replace(/-/g, 'â†’')
    .replace(/\b\w/g, (letter) => letter.toUpperCase());
}

function categoryLabel(category: Category) {
  if (category === 'gender') return 'SEX';
  return category.toUpperCase();
}

export default function Home() {
  const [started, setStarted] = useState(false);
  const [phase, setPhase] = useState(1);
  const [name, setName] = useState('');
  const [location, setLocation] = useState('');
  const [demographics, setDemographics] = useState<Demographics | null>(null);
  const [actualSelections, setActualSelections] = useState<Record<string, string>>({});
  const [selectedCategory, setSelectedCategory] = useState<Category>('race');
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');
  const [cameraActive, setCameraActive] = useState(false);
  const [cameraReady, setCameraReady] = useState(false);
  const [preview, setPreview] = useState('');

  const videoRef = useRef<HTMLVideoElement>(null);
  const streamRef = useRef<MediaStream | null>(null);
  const canvasRef = useRef<HTMLCanvasElement>(null);

  const stopCamera = useCallback(() => {
    streamRef.current?.getTracks().forEach((track) => track.stop());
    streamRef.current = null;

    if (videoRef.current) {
      videoRef.current.pause();
      videoRef.current.srcObject = null;
    }

    setCameraActive(false);
    setCameraReady(false);
  }, []);

  const startCamera = useCallback(async () => {
    setError('');
    setCameraReady(false);

    if (!navigator.mediaDevices?.getUserMedia) {
      setError('Camera access is not available in this browser. Please use Upload Instead.');
      return;
    }

    try {
      stopCamera();

      const stream = await navigator.mediaDevices.getUserMedia({
        video: {
          facingMode: 'user',
          width: { ideal: 1280 },
          height: { ideal: 720 }
        },
        audio: false
      });

      streamRef.current = stream;
      const video = videoRef.current;

      if (!video) {
        stream.getTracks().forEach((track) => track.stop());
        streamRef.current = null;
        setError('Camera preview could not be initialized.');
        return;
      }

      video.srcObject = stream;
      video.muted = true;
      video.playsInline = true;
      video.autoplay = true;
      setCameraActive(true);

      await new Promise<void>((resolve, reject) => {
        if (video.readyState >= 2) {
          resolve();
          return;
        }

        const handleLoaded = () => {
          cleanup();
          resolve();
        };
        const handleError = () => {
          cleanup();
          reject(new Error('Video preview failed to load.'));
        };
        const cleanup = () => {
          video.removeEventListener('loadedmetadata', handleLoaded);
          video.removeEventListener('error', handleError);
        };

        video.addEventListener('loadedmetadata', handleLoaded, { once: true });
        video.addEventListener('error', handleError, { once: true });
      });

      await video.play();
      setCameraReady(video.videoWidth > 0 && video.videoHeight > 0);

      if (!video.videoWidth || !video.videoHeight) {
        setError('Camera opened, but no video frame is available yet.');
      }
    } catch (cameraError) {
      stopCamera();

      if (cameraError instanceof DOMException) {
        if (cameraError.name === 'NotAllowedError') {
          setError('Camera permission was denied. Allow camera access for localhost, then try again.');
          return;
        }
        if (cameraError.name === 'NotFoundError') {
          setError('No camera was found. Please connect a camera or use Upload Instead.');
          return;
        }
      }

      setError(
        cameraError instanceof Error
          ? cameraError.message
          : 'Unable to access the camera. Please use Upload Instead.'
      );
    }
  }, [stopCamera]);

  useEffect(() => {
    if (phase !== 3) return;

    const timer = window.setTimeout(() => {
      void startCamera();
    }, 0);

    return () => {
      window.clearTimeout(timer);
      streamRef.current?.getTracks().forEach((track) => track.stop());
    };
  }, [phase, startCamera]);

  useEffect(() => {
    return () => {
      streamRef.current?.getTracks().forEach((track) => track.stop());
    };
  }, []);

  const analyzeBase64 = async (base64: string) => {
    setLoading(true);
    setError('');

    try {
      const response = await fetch('/api/phase-two', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ Image: base64 })
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error || 'Skinstric image analysis failed.');
      }

      if (!result.data?.race || !result.data?.age || !result.data?.gender) {
        throw new Error('Skinstric returned incomplete demographic data.');
      }

      setDemographics(result.data);
      setActualSelections({});
      setSelectedCategory('race');
      stopCamera();
      setPhase(4);
    } catch (analysisError) {
      setError(analysisError instanceof Error ? analysisError.message : 'Image analysis failed.');
    } finally {
      setLoading(false);
    }
  };

  const handlePhaseOne = async () => {
    if (!validateText(name) || !validateText(location)) {
      setError('Name and location are required and cannot contain numbers.');
      return;
    }

    setLoading(true);
    setError('');

    try {
      const response = await fetch('/api/phase-one', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: name.trim(), location: location.trim() })
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error || 'Unable to save your information.');
      }

      localStorage.setItem('skinstric-name', name.trim());
      localStorage.setItem('skinstric-location', location.trim());
      setPhase(2);
    } catch (phaseOneError) {
      setError(phaseOneError instanceof Error ? phaseOneError.message : 'Unable to continue.');
    } finally {
      setLoading(false);
    }
  };

  const handleImageFile = (event: ChangeEvent<HTMLInputElement>) => {
    const file = event.target.files?.[0];
    if (!file) return;

    if (!file.type.startsWith('image/')) {
      setError('Please select an image file.');
      return;
    }

    setError('');
    const reader = new FileReader();

    reader.onload = async () => {
      const result = String(reader.result || '');
      const base64 = result.includes(',') ? result.split(',')[1] : result;
      setPreview(result);
      await analyzeBase64(base64);
    };

    reader.onerror = () => setError('Unable to read the selected image.');
    reader.readAsDataURL(file);
    event.target.value = '';
  };

  const captureSelfie = async () => {
    const video = videoRef.current;
    const canvas = canvasRef.current;

    if (!video || !canvas || !cameraReady) {
      setError('Wait for the camera preview to become ready.');
      return;
    }

    const width = video.videoWidth;
    const height = video.videoHeight;

    if (!width || !height) {
      setError('Camera video is not ready yet. Please wait a moment and try again.');
      return;
    }

    canvas.width = width;
    canvas.height = height;
    const context = canvas.getContext('2d');

    if (!context) {
      setError('Unable to capture the camera image.');
      return;
    }

    context.drawImage(video, 0, 0, width, height);
    const dataUrl = canvas.toDataURL('image/jpeg', 0.9);
    const base64 = dataUrl.split(',')[1];

    setPreview(dataUrl);
    stopCamera();
    await analyzeBase64(base64);
  };

  const selectActual = (category: Category, value: string) => {
    setSelectedCategory(category);
    setActualSelections((current) => ({ ...current, [category]: value }));
  };

  const goBack = () => {
    setError('');
    stopCamera();

    if (phase === 1) {
      setStarted(false);
      return;
    }

    if (phase === 2 || phase === 3) {
      setPhase(1);
      return;
    }

    setPhase(2);
    setDemographics(null);
    setActualSelections({});
  };

  return (
    <main className='min-h-screen bg-white text-zinc-900'>
      {!started ? (
        <section className='relative flex min-h-screen flex-col overflow-hidden px-5 py-6 sm:px-8 md:px-12'>
          <header className='flex items-start justify-between'>
            <button onClick={() => setStarted(false)} className='text-left text-[10px] font-semibold tracking-[0.18em] sm:text-xs'>
              <span>SKINSTRIC</span>
              <span className='ml-3 text-zinc-400'>[ INTRO ]</span>
            </button>
            <button className='bg-black px-3 py-2 text-[9px] font-semibold tracking-[0.1em] text-white sm:px-4'>ENTER CODE</button>
          </header>

          <div className='flex flex-1 items-center justify-center'>
            <button
              onClick={() => setStarted(true)}
              className='group relative flex h-[min(78vw,560px)] w-[min(78vw,560px)] max-w-full items-center justify-center'
              aria-label='Introduce Yourself and start analysis'
            >
              <span className='absolute h-[62%] w-[62%] rotate-12 border border-dotted border-zinc-200 transition-transform duration-700 group-hover:rotate-45' />
              <span className='absolute h-[68%] w-[52%] -rotate-12 border border-dotted border-zinc-200 transition-transform duration-700 group-hover:-rotate-45' />
              <span className='absolute h-[52%] w-[72%] rotate-45 border border-dotted border-zinc-200 transition-transform duration-700 group-hover:rotate-90' />
              <span className='relative z-10 block px-4'>
                <span className='block text-[9px] font-medium tracking-[0.2em] text-zinc-500 sm:text-xs'>CLICK TO TYPE</span>
                <span className='mt-2 block border-b border-zinc-500 pb-1 text-4xl font-light tracking-tight sm:text-5xl md:text-6xl'>Introduce Yourself</span>
              </span>
            </button>
          </div>

          <button onClick={() => setStarted(false)} className='flex items-center gap-3 text-xs font-semibold tracking-[0.12em]'>
            <span className='grid h-10 w-10 place-items-center rotate-45 border border-zinc-400'>
              <FiArrowLeft className='-rotate-45' />
            </span>
            BACK
          </button>
        </section>
      ) : (
        <>
          <header className='flex items-start justify-between px-5 py-6 sm:px-8 md:px-10'>
            <button onClick={() => setStarted(false)} className='text-left text-[10px] font-semibold tracking-[0.18em] sm:text-xs'>
              SKINSTRIC <span className='ml-3 text-zinc-400'>[ INTRO ]</span>
            </button>
            <button className='bg-black px-3 py-2 text-[9px] font-semibold tracking-[0.1em] text-white sm:px-4'>ENTER CODE</button>
          </header>

          <section className='mx-auto max-w-7xl px-5 pb-10 sm:px-8 md:px-10'>
            {phase === 1 && (
              <div className='mx-auto max-w-4xl py-8 md:py-14'>
                <div className='text-center'>
                  <div className='text-xs tracking-[0.4em] text-zinc-500'>STEP 01</div>
                  <h1 className='mt-5 text-5xl font-light tracking-tight md:text-7xl'>Discover your skin.</h1>
                  <p className='mt-6 text-base text-zinc-500'>Let us begin with a little information about you.</p>
                </div>

                <div className='mx-auto mt-14 max-w-2xl space-y-10'>
                  <label className='block'>
                    <span className='flex items-center gap-2 text-sm font-semibold tracking-[0.18em]'><FiUser /> NAME</span>
                    <input value={name} onChange={(event) => setName(event.target.value)} className='mt-5 w-full border-b border-zinc-300 bg-transparent py-3 text-lg outline-none focus:border-zinc-900' placeholder='Enter your name' aria-label='Name' />
                  </label>
                  <label className='block'>
                    <span className='flex items-center gap-2 text-sm font-semibold tracking-[0.18em]'><FiMapPin /> LOCATION</span>
                    <input value={location} onChange={(event) => setLocation(event.target.value)} className='mt-5 w-full border-b border-zinc-300 bg-transparent py-3 text-lg outline-none focus:border-zinc-900' placeholder='Enter your location' aria-label='Location' />
                  </label>
                </div>

                {error && <p className='mx-auto mt-8 max-w-2xl text-sm text-red-600'>{error}</p>}

                <div className='mt-12 flex items-center justify-between'>
                  <button onClick={goBack} className='flex items-center gap-2 text-sm tracking-[0.2em] text-zinc-500'><FiArrowLeft /> BACK</button>
                  <button onClick={handlePhaseOne} disabled={loading || !validateText(name) || !validateText(location)} className='bg-black px-7 py-4 text-sm tracking-[0.2em] text-white disabled:cursor-not-allowed disabled:bg-zinc-300'>{loading ? 'PROCESSING...' : 'PROCEED'}</button>
                </div>
              </div>
            )}

            {phase === 2 && (
              <div className='mx-auto max-w-5xl py-8 md:py-14'>
                <div className='text-center'>
                  <div className='text-xs tracking-[0.4em] text-zinc-500'>STEP 02</div>
                  <h1 className='mt-5 text-5xl font-light tracking-tight md:text-7xl'>Upload your image.</h1>
                  <p className='mt-6 text-base text-zinc-500'>Upload an image so Skinstric AI can analyze your demographics.</p>
                </div>

                <div className='mx-auto mt-14 grid max-w-3xl gap-5 sm:grid-cols-2'>
                  <label className='flex min-h-64 cursor-pointer flex-col items-center justify-center border border-dashed border-zinc-300 p-10 text-center transition hover:border-zinc-900'>
                    <FiImage className='mb-5 text-3xl' />
                    <span className='text-sm font-semibold tracking-[0.18em]'>UPLOAD IMAGE</span>
                    <span className='mt-3 text-sm text-zinc-500'>JPG, PNG, or another supported image format</span>
                    <input type='file' accept='image/*' onChange={handleImageFile} className='sr-only' disabled={loading} />
                  </label>

                  <button onClick={() => { setError(''); setPhase(3); }} disabled={loading} className='flex min-h-64 flex-col items-center justify-center border border-zinc-300 p-10 text-center transition hover:border-black hover:bg-zinc-50 disabled:cursor-not-allowed'>
                    <FiCamera className='mb-5 text-3xl' />
                    <span className='text-sm font-semibold tracking-[0.18em]'>TAKE A PICTURE</span>
                    <span className='mt-3 text-sm text-zinc-500'>Open your camera and take a selfie</span>
                  </button>
                </div>

                {loading && <p className='mt-6 text-center text-sm text-zinc-500'>ANALYZING IMAGE...</p>}
                {error && <p className='mt-6 text-center text-sm text-red-600'>{error}</p>}

                <div className='mt-12'><button onClick={goBack} className='flex items-center gap-2 text-sm tracking-[0.2em] text-zinc-500'><FiArrowLeft /> BACK</button></div>
              </div>
            )}

            {phase === 3 && (
              <div className='mx-auto max-w-5xl py-8 md:py-14'>
                <div className='text-center'>
                  <div className='text-xs tracking-[0.4em] text-zinc-500'>STEP 03</div>
                  <h1 className='mt-5 text-5xl font-light tracking-tight md:text-7xl'>Take a selfie.</h1>
                  <p className='mt-6 text-base text-zinc-500'>Center your face in the frame, then take your picture.</p>
                </div>

                <div className='mx-auto mt-10 max-w-3xl overflow-hidden border border-zinc-200 bg-black'>
                  <video ref={videoRef} autoPlay muted playsInline className='aspect-video h-auto w-full object-cover' aria-label='Camera preview' />
                </div>

                <div className='mx-auto mt-6 grid max-w-3xl gap-3 sm:grid-cols-2'>
                  <button onClick={captureSelfie} disabled={!cameraReady || loading} className='flex items-center justify-center gap-3 bg-black px-6 py-5 text-sm tracking-[0.15em] text-white disabled:cursor-not-allowed disabled:bg-zinc-300'><FiCamera /> {loading ? 'ANALYZING...' : 'TAKE PICTURE'}</button>
                  <button onClick={stopCamera} disabled={!cameraActive} className='flex items-center justify-center gap-3 border border-zinc-300 px-6 py-5 text-sm tracking-[0.15em] disabled:cursor-not-allowed disabled:text-zinc-300'><FiX /> STOP CAMERA</button>
                </div>

                {error && <p className='mt-6 text-center text-sm text-red-600'>{error}</p>}
                <div className='mt-10'><button onClick={goBack} className='flex items-center gap-2 text-sm tracking-[0.2em] text-zinc-500'><FiArrowLeft /> BACK</button></div>
                <canvas ref={canvasRef} className='hidden' />
              </div>
            )}

            {phase === 4 && demographics && (
              <div className='py-4 md:py-8'>
                <div className='mb-8'>
                  <div className='text-xs font-semibold tracking-[0.12em]'>A.I. ANALYSIS</div>
                  <h1 className='mt-1 text-5xl font-light uppercase tracking-tight md:text-7xl'>DEMOGRAPHICS</h1>
                  <p className='mt-2 text-xs font-medium text-zinc-500'>PREDICTED RACE & AGE</p>
                </div>

                <div className='grid gap-3 lg:grid-cols-[120px_minmax(0,1fr)_280px]'>
                  <div className='space-y-1'>
                    {CATEGORY_ORDER.map((category) => {
                      const top = sortScores(demographics[category])[0];
                      const selected = selectedCategory === category;
                      return (
                        <button key={category} onClick={() => setSelectedCategory(category)} className={`w-full border p-4 text-left ${selected ? 'border-black bg-black text-white' : 'border-zinc-200 bg-zinc-100'}`}>
                          <div className='text-sm font-semibold'>{top ? formatLabel(top[0]) : 'â€”'}</div>
                          <div className='mt-2 text-xs font-semibold'>{categoryLabel(category)}</div>
                        </button>
                      );
                    })}
                  </div>

                  <div className='min-h-[330px] border-t border-zinc-300 bg-zinc-50 p-6 sm:p-10'>
                    {(() => {
                      const ranked = sortScores(demographics[selectedCategory]);
                      const [topValue, topScore] = ranked[0] || ['â€”', 0];
                      return (
                        <div className='flex h-full flex-col'>
                          <h2 className='text-3xl font-light sm:text-4xl'>{formatLabel(topValue)}</h2>
                          <div className='flex flex-1 items-center justify-center py-8'>
                            <div className='relative grid h-56 w-56 place-items-center rounded-full border-[6px] border-zinc-300 sm:h-64 sm:w-64'>
                              <div className='absolute inset-[-6px] rounded-full border-[6px] border-transparent border-r-black border-t-black' style={{ transform: `rotate(${Math.round(topScore * 360)}deg)` }} />
                              <span className='text-3xl font-light'>{(topScore * 100).toFixed(0)}%</span>
                            </div>
                          </div>
                        </div>
                      );
                    })()}
                  </div>

                  <aside className='border border-zinc-200'>
                    <div className='flex items-center justify-between border-b border-zinc-200 px-4 py-3 text-xs font-semibold tracking-[0.1em]'><span>{categoryLabel(selectedCategory)}</span><span>A.I. CONFIDENCE</span></div>
                    <div>
                      {sortScores(demographics[selectedCategory]).map(([value, score], index) => (
                        <button key={value} onClick={() => selectActual(selectedCategory, value)} className={`flex w-full items-center justify-between border-b border-zinc-100 px-4 py-3 text-left text-sm ${actualSelections[selectedCategory] === value || (index === 0 && !actualSelections[selectedCategory]) ? 'bg-black text-white' : 'hover:bg-zinc-50'}`}>
                          <span className='flex items-center gap-2'><span className='text-xs'>â—‡</span>{formatLabel(value)}</span>
                          <span>{Math.round(score * 100)}%</span>
                        </button>
                      ))}
                    </div>
                  </aside>
                </div>

                <p className='mt-6 text-center text-xs text-zinc-500'>If A.I. estimate is wrong, select the correct one.</p>

                <div className='mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_280px]'>
                  <div className='space-y-8'>
                    {CATEGORY_ORDER.map((category) => (
                      <section key={category} className='border-t border-zinc-200 pt-5'>
                        <h2 className='text-sm font-semibold tracking-[0.2em]'>{categoryLabel(category)}</h2>
                        <div className='mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-3'>
                          {sortScores(demographics[category]).map(([value, score]) => (
                            <button key={value} onClick={() => selectActual(category, value)} className={`flex items-center justify-between border p-4 text-left text-sm ${actualSelections[category] === value ? 'border-black bg-black text-white' : 'border-zinc-200 hover:border-zinc-900'}`}>
                              <span>{formatLabel(value)}</span>
                              <span className='font-mono text-xs'>{(score * 100).toFixed(2)}%</span>
                            </button>
                          ))}
                        </div>
                      </section>
                    ))}
                  </div>

                  <aside className='border border-zinc-200 p-6'>
                    <h2 className='text-xs font-semibold tracking-[0.25em]'>ACTUAL</h2>
                    <div className='mt-6 space-y-6'>
                      {CATEGORY_ORDER.map((category) => (
                        <div key={category} className='border-b border-zinc-200 pb-4'>
                          <div className='text-xs uppercase tracking-[0.2em] text-zinc-500'>{categoryLabel(category)}</div>
                          <div className='mt-2 text-sm font-medium'>{actualSelections[category] ? formatLabel(actualSelections[category]) : 'Select above'}</div>
                        </div>
                      ))}
                    </div>
                  </aside>
                </div>

                {preview && <div className='mx-auto mt-8 max-w-md'><Image src={preview} alt='Analysis image' width={1280} height={720} unoptimized className='h-auto w-full border border-zinc-200' /></div>}

                <div className='mt-10 flex items-center justify-between'>
                  <button onClick={goBack} className='flex items-center gap-2 text-sm tracking-[0.2em] text-zinc-500'><FiArrowLeft /> BACK</button>
                  <button onClick={() => { setDemographics(null); setActualSelections({}); setPhase(2); }} className='text-sm tracking-[0.2em]'>HOME</button>
                </div>
              </div>
            )}
          </section>
        </>
      )}
    </main>
  );
}

